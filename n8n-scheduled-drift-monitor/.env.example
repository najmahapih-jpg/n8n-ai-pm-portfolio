# Copy to .env or set these in your shell profile. Do not commit real values.
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
N8N_MCP_TOKEN=
N8N_CONTAINER_NAME=n8n

# --- Monitor 2: Answer-Quality Drift (live, opt-in) -------------------------------------------
# The collector re-runs Project A's eval harness over the live SUTs. DEFAULT is a deterministic stub
# (pinned A-response snapshot in fixtures/eval/); set mode:"live" in the run config to call A for real.
# The WORKFLOW reaches the n8n host at host.docker.internal:5678 (it is containerized); this host-side
# var is only for any local driver. CI / verify:live never call A.
EVAL_HARNESS_WEBHOOK_URL=http://localhost:5678/webhook/portfolio/llm-eval-harness

# --- Monitor 1: Corpus Freshness re-embed (live, opt-in) ---------------------------------------
# On a detected source change in mode:"live" + reportOnly:false, the affected chunks are re-embedded
# into Project B's Supabase `documents` (same write path/contract as B's Ingest-Corpus.ps1). DEFAULT is
# report-only — nothing below is read. Put real values in local .env ONLY (never committed); the secret
# scan + .gitignore enforce that. Use the SAME Supabase project as Project B.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=documents
SUPABASE_QUERY_NAME=match_documents

# Live embeddings (re-embed) + the digest LLM run on local Ollama; the WORKFLOW reaches it at
# host.docker.internal:11434 (containerized). These host-side vars default to localhost so nothing is
# required. CI / verify:live never touch a live model (stub digest is the default).
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
OLLAMA_GEN_MODEL=llama3.2:3b

# --- Notification (live, opt-in) — DEFERRED ----------------------------------------------------
# DEFAULT emit is a digest file artifact under artifacts/runs/. A Feishu/Slack incoming-webhook push is
# opt-in and stubbed by default; nothing is read unless a live notify is explicitly enabled.
DIGEST_NOTIFY_WEBHOOK_URL=
