# Copy to .env. Do not commit real values (.env is gitignored; the secret scan rejects cli_ ids
# and webhook URLs in tracked files).
# The offline gate (verify:core) needs NOTHING here — it runs green with zero config.

# --- Feishu self-built app (开发者后台 -> 凭证与基础信息) ---------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- Local signed interaction-gateway (the adapter's ONLY downstream) ---------------------------
GATEWAY_URL=http://localhost:5678/webhook/portfolio/interaction-gateway
# MUST equal the GATEWAY_SIGNING_SECRET in your n8n docker compose .env (signer == verifier).
GATEWAY_SIGNING_SECRET=
