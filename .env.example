# Copy to .env or set these in your shell profile.
# Do not commit real values.
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
N8N_MCP_TOKEN=
N8N_CONTAINER_NAME=n8n

# Optional local-only Feishu custom bot support.
# Keep real values in your Docker/runtime env file, not in this repository.
FEISHU_BOT_WEBHOOK_URL=
FEISHU_BOT_SIGNING_SECRET=
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
