# Copy to .env or set these in your shell profile. Do not commit real values.
# NONE of these are needed for the offline gates (verify:static / verify:json / verify:agent /
# verify:workflow / verify:gateway-client / verify:canonical) — those run green with zero config.
# Everything below is for the OPT-IN live tiers only.

# --- n8n REST API (deploy/reactivate scripts + live tiers) ------------------------------------
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# --- verify:tools (live gateway tool execution) ------------------------------------------------
# HMAC secret the agent uses to sign gateway requests. MUST equal the GATEWAY_SIGNING_SECRET
# injected into the n8n task-runner env (see the interaction-gateway repo / your n8n compose .env).
GATEWAY_SIGNING_SECRET=

# --- verify:llm (live LLM planner, local Ollama) -----------------------------------------------
OLLAMA_URL=http://localhost:11434
AGENT_LLM_MODEL=llama3.2:3b
AGENT_TRUST_THRESHOLD=0.8
