# Copy to .env or set these in your shell profile. Do not commit real values.
# NONE of these are needed for the offline gates (verify:static / verify:json / verify:gateway /
# verify:workflow / verify:canonical) — those run green with zero config.
# Everything below is for the OPT-IN live tier (verify:live) and the deploy scripts only.

# --- n8n REST API (Sync / Reactivate scripts) ---------------------------------------------------
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# --- verify:live (signed end-to-end probe against the deployed gateway) -------------------------
# HMAC-SHA256 secret used to sign test requests. MUST equal the GATEWAY_SIGNING_SECRET injected
# into the n8n task-runner environment (your n8n docker compose .env), or every probe gets 401.
GATEWAY_SIGNING_SECRET=
