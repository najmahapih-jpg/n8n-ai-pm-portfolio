# Copy to .env or set these in your shell profile. Do not commit real values.
# The offline gates (verify:self / verify:portfolio and plain Test-Contract.ps1) need NOTHING here —
# they run green with zero config. These are only read by the OPT-IN live conformance mode
# (Test-Contract.ps1 -Live), which honestly SKIPS when n8n or the key is unavailable.

N8N_API_URL=http://localhost:5678
N8N_API_KEY=
