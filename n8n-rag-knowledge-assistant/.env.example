# Copy to .env or set these in your shell profile. Do not commit real values.
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
N8N_MCP_TOKEN=
N8N_CONTAINER_NAME=n8n

# --- Phase 2b (live backend) — DEFERRED, not wired this phase ---------------------------------
# Phase 2a is stub-only: the workflow NORMALIZES retrievalSource:"supabase" / generationSource:
# "ollama" but DEGRADES THEM TO STUB, so nothing below is read yet and CI never reaches a live
# backend. These are placeholders for Phase 2b (live Supabase pgvector retrieval). Put the real
# values in local .env ONLY (never committed); the secret scan + .gitignore enforce that.
# SUPABASE_URL is the project REST URL; SUPABASE_SERVICE_ROLE_KEY is the privileged service_role JWT.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=documents
SUPABASE_QUERY_NAME=match_documents

# Live embeddings + generation (Phase 2b) run on local Ollama; the WORKFLOW reaches it at
# host.docker.internal:11434 (it is containerized). These host-side vars are only for any local
# driver and default to localhost so nothing is required. CI / verify:live never touch a live model.
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
OLLAMA_GEN_MODEL=llama3.2:3b
