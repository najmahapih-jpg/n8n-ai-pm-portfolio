{
  "id": "secret-in-array",
  "description": "A secret hidden in a bare string-array element (payload.notes[1]) must be stripped from the forwarded payload (not only object property values).",
  "env": { "GATEWAY_SIGNING_SECRET": "gateway-test-secret", "GATEWAY_NOW_SECONDS": 1000000, "GATEWAY_REPLAY_WINDOW_SECONDS": 300, "GATEWAY_MAX_BODY_BYTES": 65536 },
  "request": { "intent": "support-triage", "payload": { "subject": "logs attached", "notes": ["all good", "leaked sk-ABCDEFGH12345678 in here"] }, "timestamp": 1000000, "sign": true },
  "expect": { "statusCode": 200, "ok": true, "routedTo": ["support-triage"], "strippedCountMin": 1, "noSecretInOutput": true, "traceIdNonEmpty": true }
}
