# Copy to .env or set these in your shell profile. Do not commit real values.
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
N8N_MCP_TOKEN=
N8N_CONTAINER_NAME=n8n

# Live LLM-as-judge (v0.2.0). The WORKFLOW reaches Ollama at host.docker.internal:11434 (it is
# containerized); these host-side vars are only for the npm run verify:judge driver, and both default
# to localhost so nothing is required. CI / verify:live never touch a live model (stub is the default).
# OLLAMA_URL is read by scripts/Test-LiveJudge.ps1; OLLAMA_BASE_URL is kept for reference parity.
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud judges — DEFERRED (judgeSource:"openai"/... not built). Local Ollama is the live judge.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
