{
  "name": "n8n-product-feedback-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Local n8n Workflow-as-Code project: LLM-in-the-loop product feedback classification with a deterministic fallback, human-in-the-loop gate, redacted audit, and reproducible pin-data eval.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "hooks:install": "pwsh -NoProfile -File ./scripts/Install-GitHooks.ps1",
    "registry:build": "pwsh -NoProfile -File ./scripts/Build-WorkflowIndex.ps1",
    "smoke": "pwsh -NoProfile -File ./scripts/Invoke-SmokeTest.ps1",
    "verify:workflow": "node ./scripts/test-feedback-workflow.mjs",
    "verify:static": "pwsh -NoProfile -File ./scripts/Invoke-StaticValidation.ps1",
    "verify:json": "pwsh -NoProfile -File ./scripts/Test-N8nWorkflowJson.ps1 -Path ./workflows/canonical -MinimumNodes 28 && pwsh -NoProfile -File ./scripts/Test-N8nWorkflowJson.ps1 -Path ./workflows/releases -MinimumNodes 0",
    "verify:live": "pwsh -NoProfile -File ./scripts/Test-N8nConnection.ps1 && pwsh -NoProfile -File ./scripts/Sync-N8nWorkflowFromSdk.ps1 && pwsh -NoProfile -File ./scripts/Test-ProductFeedbackWorkflow.ps1"
  },
  "dependencies": {
    "@n8n/workflow-sdk": "0.15.1"
  },
  "engines": {
    "node": ">=20"
  }
}
