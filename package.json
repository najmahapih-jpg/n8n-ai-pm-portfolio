{
  "name": "n8n-workflow-as-code",
  "version": "0.3.0",
  "private": true,
  "description": "Workflow-as-Code project for local n8n automations built with MCP, PowerShell validation, and scrubbed Git releases.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "hooks:install": "pwsh -NoProfile -File ./scripts/Install-GitHooks.ps1",
    "verify:static": "pwsh -NoProfile -File ./scripts/Invoke-StaticValidation.ps1",
    "verify:json": "pwsh -NoProfile -File ./scripts/Test-N8nWorkflowJson.ps1 -Path ./workflows/canonical -MinimumNodes 27 && pwsh -NoProfile -File ./scripts/Test-N8nWorkflowJson.ps1 -Path ./workflows/releases -MinimumNodes 0",
    "verify:feishu": "pwsh -NoProfile -File ./scripts/Test-FeishuWorkflowJson.ps1",
    "verify:live": "pwsh -NoProfile -File ./scripts/Test-N8nConnection.ps1 && pwsh -NoProfile -File ./scripts/Sync-N8nWorkflowFromSdk.ps1 && pwsh -NoProfile -File ./scripts/Test-SupportTriageWorkflow.ps1"
  },
  "dependencies": {
    "@n8n/workflow-sdk": "0.15.1"
  },
  "engines": {
    "node": ">=20"
  }
}
